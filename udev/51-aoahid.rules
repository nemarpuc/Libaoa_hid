# libaoahid udev rules.
#
# This library implements AOA "Mode A" only: it never sends ACCESSORY_START
# and the device never re-enumerates as Google's Accessory VID/PID range
# (18D1:2D00-2D05). While connected, the phone keeps its own OEM VID/PID in
# whatever USB mode it is already in (MTP, PTP, "No data transfer", etc.) --
# for example a Samsung phone commonly enumerates as 04E8:xxxx. There is no
# fixed list of OEM VID/PIDs to match, since it is whichever phone you plug
# in, so a wildcard-by-VID rule below is not meaningful for this library.
#
# Most current distributions already grant the graphical/logind session
# access to hotplugged USB devices via systemd-udev's own uaccess rules
# (commonly /usr/lib/udev/rules.d/70-uaccess.rules), so you frequently need
# nothing further. If aoahid_device_open() still fails with
# AOAHID_ERR_ACCESS, install this file to
# /etc/udev/rules.d/51-aoahid.rules, then run:
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# and reconnect the phone.
SUBSYSTEM=="usb", TAG+="uaccess"

# If your distribution does not ship uaccess rules and you would rather grant
# a specific local group instead of the logind seat, find your phone's real
# VID with `lsusb` while it is connected and use that instead of a wildcard;
# a udev rule is a security boundary, so avoid MODE="0666" and avoid matching
# every USB device on the system. Example, uncommented and edited for one
# real device already seen while developing against this library
# (Samsung Galaxy: 04e8:6860 in MTP mode -- your VID/PID will differ):
# SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0660", GROUP="plugdev"

# The rule below is kept only for the historical/reference "Mode B" protocol
# path described in docs/AOA_HID_GUIDE.md section 4.2. libaoahid does not
# implement Mode B (AOAHID_START_ACCESSORY_MODE returns AOAHID_ERR_UNSUPPORTED
# before any USB I/O; see README.md and docs/SOURCE_CONFLICTS.md T-07), so a
# device never actually re-enumerates under this VID/PID range while used
# with this library. It is retained here only so the rule exists if a future
# accessory-mode implementation is added.
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", MODE="0660", GROUP="plugdev"
